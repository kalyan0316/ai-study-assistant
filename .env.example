# Copy this file to `.env` and fill in a key.
# Leave LLM_API_KEY empty to run in MOCK mode (no network calls, canned study set).
#
# Any OpenAI-compatible chat-completions endpoint works. Examples:
#
#   Groq (free tier, fast) — get a key at https://console.groq.com/keys
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=openai/gpt-oss-120b
#
#   Google Gemini (free tier):
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL=gemini-2.5-flash
#
#   OpenRouter:
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
#   Ollama (local, free):
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=llama3.1
#     LLM_API_KEY=ollama

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# The server retries without JSON mode automatically if the model rejects it.
# Set to false to never send it, e.g. if your provider rejects `response_format: { type: "json_object" }`.
LLM_JSON_MODE=true

# Port for `npm start` (the dev server always uses 8787 for the API).
PORT=3000
